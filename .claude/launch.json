{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ephyria-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ephyria-local-db",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql://ephyria@127.0.0.1:54329/ephyria",
        "DIRECT_URL=postgresql://ephyria@127.0.0.1:54329/ephyria",
        "npx",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}