# ───────────── Εφαρμογή ─────────────
# Δημόσια διεύθυνση του site, χωρίς τελική κάθετο
APP_URL=http://localhost:3000

# ───────────── PostgreSQL + PgBouncer ─────────────
# Η εφαρμογή μιλά στο PgBouncer (transaction mode). Κράτα το ?pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@PGBOUNCER_HOST:6432/ephyria?pgbouncer=true&connection_limit=5"
# Απευθείας σύνδεση στην Postgres, μόνο για τα migrations (prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@POSTGRES_HOST:5432/ephyria"

# ───────────── Διαχειριστικό (Auth.js) ─────────────
# Δημιούργησέ το με: npx auth secret   ή   openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Ο πρώτος διαχειριστής που φτιάχνει το `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ───────────── Viva Payments (Smart Checkout) ─────────────
# demo ή production
VIVA_ENV=demo
# Smart Checkout credentials: Viva > Ρυθμίσεις > API Access
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# Merchant ID και API Key: χρειάζονται μόνο για την επαλήθευση του webhook
VIVA_MERCHANT_ID=
VIVA_API_KEY=
# Κωδικός πηγής πληρωμής (4 ψηφία): Viva > Πωλήσεις > Online πληρωμές > Ιστοσελίδες/Εφαρμογές
# Στην πηγή όρισε:
#   Success URL: {APP_URL}/api/viva/return
#   Failure URL: {APP_URL}/api/viva/return?failed=1
# Webhook (Transaction Payment Created): {APP_URL}/api/viva/webhook
VIVA_SOURCE_CODE=

# ───────────── Κρατήσεις ─────────────
# Ποσοστό που χρεώνεται online (100 = εξόφληση, 30 = προκαταβολή 30%)
BOOKING_DEPOSIT_PERCENT=100
# Λεπτά που κρατιούνται οι ημερομηνίες όσο ο επισκέπτης πληρώνει
BOOKING_HOLD_MINUTES=20

# ───────────── Αυτόματο περιεχόμενο (AI) ─────────────
# Οποιοδήποτε OpenAI-compatible API. Προεπιλογή το OpenRouter.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5.5
# true = τα άρθρα δημοσιεύονται αμέσως, false = μένουν πρόχειρα για έγκριση στο διαχειριστικό
AI_AUTO_PUBLISH=false
# Μυστικό για το /api/cron/generate-content (Authorization: Bearer ...)
CRON_SECRET=

# ───────────── Email (Mailgun) ─────────────
# Κενό = δεν στέλνονται email
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# https://api.eu.mailgun.net για domain στην ΕΕ, https://api.mailgun.net για ΗΠΑ
MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAIL_FROM="Ephyria Lux <reservations@example.com>"
# Πού έρχονται οι ειδοποιήσεις για νέες κρατήσεις και μηνύματα
MAIL_NOTIFY=

# ───────────── Bunny CDN (βιβλιοθήκη μέσων) ─────────────
# Storage zone: bunny.net > Storage > η ζώνη σου > FTP & API Access
BUNNY_STORAGE_ZONE=
# Ο κωδικός (Password) της storage zone, όχι το API key του λογαριασμού
BUNNY_STORAGE_KEY=
# storage.bunnycdn.com για Falkenstein, αλλιώς π.χ. uk.storage.bunnycdn.com, ny.storage.bunnycdn.com
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Η διεύθυνση της Pull Zone που είναι συνδεδεμένη με τη storage zone, χωρίς τελική κάθετο
BUNNY_CDN_URL=https://ephyria.b-cdn.net

# ───────────── Google (προαιρετικά) ─────────────
# Φορτώνουν μόνο αφού ο επισκέπτης αποδεχτεί τα cookies.
GA_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_BOOKING_LABEL=
GTM_ID=

# Σημείωση: τα στοιχεία Bunny, Mailgun, Viva και Google ορίζονται και από το
# διαχειριστικό (Ρυθμίσεις). Ό,τι αποθηκευτεί εκεί υπερισχύει αυτού του αρχείου
# και κρυπτογραφείται με το AUTH_SECRET. Αν αλλάξει το AUTH_SECRET, ξαναπεράστε τα.
