// Ephyria Lux. PostgreSQL behind PgBouncer.
// DATABASE_URL = pooled connection (PgBouncer, ?pgbouncer=true), used by the app.
// DIRECT_URL   = direct connection to Postgres, used only by prisma migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  RESERVATIONS
  EDITOR
  AUDITOR
}

enum ReservationStatus {
  PENDING // temporary hold while the guest pays; expires at holdExpiresAt
  CONFIRMED
  CANCELLED
  BLOCKED // dates blocked by the admin
}

enum ReservationSource {
  WEB
  MANUAL
}

enum PaymentMethod {
  VIVA
  CASH
  BANK
  POS
}

enum TicketType {
  CLEANING
  GUEST_REQUEST
  MAINTENANCE
  DAMAGE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  audit        AuditEvent[]
  tickets      Ticket[]
  activities   Activity[]
}

/// A bookable room. Names and descriptions live in the dictionaries, keyed by slug.
model Unit {
  id         String  @id @default(cuid())
  slug       String  @unique
  building   String
  sort       Int     @default(0)
  capacity   Int
  priceCents Int // per night, in euro cents
  active     Boolean @default(true)
  reservations ReservationUnit[]
  rates        RatePeriod[]
  tickets      Ticket[]
}

/// Seasonal price for a villa. A night inside the period costs priceCents instead of the villa's base price.
model RatePeriod {
  id         String   @id @default(cuid())
  unitId     String
  name       String
  from       DateTime @db.Date
  to         DateTime @db.Date // inclusive
  priceCents Int
  minNights  Int      @default(1)
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, from, to])
}

/// CRM contact. One per email address.
model Guest {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  phone            String?
  country          String?
  language         String   @default("el")
  vip              Boolean  @default(false)
  marketingConsent Boolean  @default(false)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  reservations     Reservation[]
  inquiries        Inquiry[]
  activities       Activity[]
  tickets          Ticket[]
}

/// A note, call or email logged on a guest's timeline.
model Activity {
  id        String       @id @default(cuid())
  guestId   String
  userId    String?
  type      ActivityType @default(NOTE)
  text      String       @db.Text
  createdAt DateTime     @default(now())
  guest     Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([guestId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String
  amountCents   Int // negative for a refund
  method        PaymentMethod
  note          String?
  createdAt     DateTime      @default(now())
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

/// One model for the four kinds of operational work: cleaning, guest requests, maintenance and damages.
model Ticket {
  id             String         @id @default(cuid())
  type           TicketType
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  title          String
  description    String?        @db.Text
  dueDate        DateTime?      @db.Date
  unitId         String?
  reservationId  String?
  guestId        String?
  assigneeId     String?
  costCents      Int? // repair or replacement cost (damages, maintenance)
  chargedToGuest Boolean        @default(false)
  autoKey        String?        @unique // set on generated cleaning tasks so they are never created twice
  createdAt      DateTime       @default(now())
  doneAt         DateTime?
  unit           Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  reservation    Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest          Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  assignee       User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([type, status, dueDate])
}

/// CMS: a text of the public site, overriding the built-in dictionary. key is a dot path, e.g. "hero.lines.0".
model ContentBlock {
  key       String
  locale    String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@id([key, locale])
}

model Reservation {
  id                String            @id @default(cuid())
  code              String            @unique
  status            ReservationStatus @default(PENDING)
  source            ReservationSource @default(WEB)
  checkIn           DateTime          @db.Date
  checkOut          DateTime          @db.Date
  adults            Int               @default(2)
  children          Int               @default(0)
  guestName         String
  guestEmail        String
  guestPhone        String?
  notes             String?           @db.Text
  locale            String            @default("el")
  totalCents        Int // price snapshot at booking time
  dueCents          Int // amount charged online (deposit or full)
  holdExpiresAt     DateTime?
  vivaOrderCode     String?           @unique
  vivaTransactionId String?           @unique
  consentAt         DateTime?
  createdAt         DateTime          @default(now())
  guestId           String?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  internalNotes     String?           @db.Text
  guest             Guest?            @relation(fields: [guestId], references: [id], onDelete: SetNull)
  units             ReservationUnit[]
  payments          Payment[]
  tickets           Ticket[]

  @@index([checkIn, checkOut])
  @@index([status])
}

model ReservationUnit {
  reservationId String
  unitId        String
  priceCents    Int // nightly price snapshot
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  unit          Unit        @relation(fields: [unitId], references: [id])

  @@id([reservationId, unitId])
  @@index([unitId])
}

model Article {
  id           String        @id @default(cuid())
  slug         String        @unique
  topic        String
  status       ArticleStatus @default(DRAFT)
  model        String
  createdAt    DateTime      @default(now())
  publishedAt  DateTime?
  translations ArticleTranslation[]

  @@index([status, publishedAt])
}

model ArticleTranslation {
  articleId       String
  locale          String
  title           String
  excerpt         String  @db.Text
  body            String  @db.Text
  metaTitle       String
  metaDescription String  @db.Text
  article         Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, locale])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  locale    String
  handled   Boolean  @default(false)
  consentAt DateTime
  createdAt DateTime @default(now())
  guestId   String?
  guest     Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// A file in the media library. Stored on Bunny Storage and served from the Bunny CDN pull zone
/// (or from /public/media-local while Bunny is not configured).
model MediaAsset {
  id        String    @id @default(cuid())
  kind      MediaKind
  path      String    @unique // path inside the storage zone, e.g. "videos/places/corinth-canal.mp4"
  url       String // public URL
  poster    String? // still frame for videos
  title     String
  credit    String? // licence or author, shown where required
  slot      String?   @unique // where the site uses it, e.g. "place.corinth-canal.video"
  bytes     Int
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())
}

/// Integration settings edited in the admin. Values are encrypted at rest (AES-256-GCM, key from AUTH_SECRET).
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
